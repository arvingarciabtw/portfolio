{
	"name": "portfolio",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.9.0",
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm gen && vite build",
		"gen": "wrangler types",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"check": "pnpm gen && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24",
		"mdsvex": "^0.12.8",
		"rehype-slug": "^6.0.0",
		"shiki": "^4.4.3",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.5",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"wrangler": "^4.137.0"
	}
}
